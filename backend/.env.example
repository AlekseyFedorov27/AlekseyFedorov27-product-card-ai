# OpenAI (по умолчанию)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# DeepSeek (раскомментируйте вместо блока выше):
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

MAX_TOKENS=24000
TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=0
CHECKPOINT_DB=:memory:
# true — только если провайдер поддерживает response_format={"type":"json_object"}.
# OpenAI/DeepSeek поддерживают. Многие "OpenAI-совместимые" — нет → 400.
USE_JSON_MODE=false